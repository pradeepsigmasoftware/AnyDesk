<Window x:Class="RemoteDesktop.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SysConnector" Height="690" Width="1000" MinHeight="600" MinWidth="840" Background="#0B1220" Foreground="#E8F0F7" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#121E2E"/><SolidColorBrush x:Key="Teal" Color="#22C6B5"/>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0B1421"/><Setter Property="Foreground" Value="#F3F7FA"/><Setter Property="BorderBrush" Value="#304358"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="CaretBrush" Value="White"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#22C6B5"/><Setter Property="Foreground" Value="#07131D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="17,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
</Window.Resources>
<Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Border Width="42" Height="42" CornerRadius="12" Background="#173B48" DockPanel.Dock="Left"><TextBlock Text="↗" Foreground="{StaticResource Teal}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0"><TextBlock Text="SYSCONNECTOR" FontSize="18" FontWeight="Bold"/><TextBlock Text="REMOTE DESKTOP" FontSize="10" Foreground="#8FA5B8"/></StackPanel><Border DockPanel.Dock="Right" Background="#17332F" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#39D9A3" Margin="0,0,8,0"/><TextBlock Text="Ready for connections" Foreground="#A6E6D2" FontSize="12"/></StackPanel></Border></DockPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Start a session" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Connect to another device or share this one with someone you trust." Foreground="#94A8BB" TextWrapping="Wrap" Margin="0,0,0,24"/>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="CONNECT TO A DEVICE" FontSize="11" FontWeight="Bold" Foreground="#91A8BA" Margin="0,0,0,12"/><TextBox x:Name="RemoteIdBox" MaxLength="6" ToolTip="Enter the six digit remote user ID"/><Button Content="Connect" Margin="0,12,0,0" Click="Connect_Click"/><TextBlock x:Name="ConnectionMessage" Text="Enter a six digit user ID to begin." Foreground="#91A8BA" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Background="{StaticResource Panel}" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="RECENT CONNECTIONS" FontSize="11" FontWeight="Bold" Foreground="#91A8BA" Margin="0,0,0,12"/><TextBlock Text="No recent connections" Foreground="#70869A"/></StackPanel></Border></StackPanel>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="23"><StackPanel><TextBlock Text="This device" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="Share your user ID with the person connecting." Foreground="#94A8BB" TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="YOUR USER ID" FontSize="11" FontWeight="Bold" Foreground="#91A8BA" Margin="0,0,0,8"/><DockPanel><TextBox x:Name="UserIdBox" IsReadOnly="True" FontSize="22" FontWeight="Bold"/><Button Content="Copy" Margin="8,0,0,0" Padding="15,8" Click="CopyId_Click"/></DockPanel><TextBlock Text="ACCESS PIN" FontSize="11" FontWeight="Bold" Foreground="#91A8BA" Margin="0,19,0,8"/><TextBox x:Name="PinBox" MaxLength="4" FontSize="18" ToolTip="Enter exactly four digits"/><DockPanel Margin="0,8,0,0"><Button Content="Save PIN" Padding="14,8" Click="SavePin_Click"/><Button Content="Generate" ToolTip="Generate a new four digit PIN" Margin="8,0,0,0" Padding="14,8" Click="RefreshPin_Click"/></DockPanel><TextBlock x:Name="PinMessage" Text="Use exactly four digits. Your saved PIN remains after restarting the app." Foreground="#91A8BA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/><Border Background="#18283A" CornerRadius="8" Padding="12" Margin="0,20,0,0"><TextBlock Text="Every incoming session must be approved on this computer. The current build is a UI and identity MVP; remote screen control is not enabled yet." Foreground="#B6C8D8" FontSize="12" TextWrapping="Wrap"/></Border></StackPanel></Border>
</Grid><DockPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="Encrypted remote access · Consent required" Foreground="#70869A" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="MVP · 0.1" Foreground="#70869A" FontSize="11"/></DockPanel></Grid></Window>
